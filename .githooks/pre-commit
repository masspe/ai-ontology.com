#!/bin/sh
# Refuse a commit that would introduce a file shape that hides executable
# code (fake fonts, folderOpen tasks, obfuscated sources). Enable once per clone:
#   git config core.hooksPath .githooks
# See scripts/repo_guard.py.
py=python3
command -v python3 >/dev/null 2>&1 || py=python
exec "$py" scripts/repo_guard.py
