/target
**/*.rs.bk
Cargo.lock.bak
.DS_Store
*.swp
.idea/
.vscode/
data/
*.db/
*.zip
# Default settings file when no --data directory is given.
.ontology/
# TypeScript output must never land next to the sources: Vite resolves
# .js before .ts and would serve stale artifacts.
web/src/**/*.js
!web/src/lib/msBE.js
web/dist/
# Coverage reports and the shields.io badge documents are generated by
# `cargo llvm-cov`, `vitest --coverage` and scripts/coverage_badges.py; the
# CI publishes the badges on the `coverage-badges` branch, never in main.
web/coverage/
badges/
lcov.info
