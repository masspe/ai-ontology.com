{
  "name": "ontology-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "author": "Winven AI Sarl, Route de Crassier 7, 1262 Eysins, VD, CH",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,auth,web -c blue,magenta,green \"npm:dev:server\" \"npm:dev:auth\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "cargo run --manifest-path ../Cargo.toml -p ontology-cli -- --data ../data serve --bind 127.0.0.1:5000",
    "dev:auth": "npm --prefix ../auth-server run dev",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dagre": "^0.7.52",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
